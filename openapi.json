  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "suggestion_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Suggestion Ids"
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id",
            "default": "test@mail.com"
          }
        },
        "type": "object",
        "required": [
          "suggestion_ids"
        ],
        "title": "ApproveRequest",
        "description": "Request schema for approving suggestions"
      },
      "ApproveResponse": {
        "properties": {
          "approved": {
            "type": "integer",
            "title": "Approved"
          },
          "rejected": {
            "type": "integer",
            "title": "Rejected"
          },
          "errors": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Errors",
            "default": []
          },
          "reconciliation_entries": {
            "items": {
              "$ref": "#/components/schemas/ReconciliationEntryResponse"
            },
            "type": "array",
            "title": "Reconciliation Entries",
            "default": []
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "approved",
          "rejected",
          "timestamp"
        ],
        "title": "ApproveResponse",
        "description": "Response schema for approval operation"
      },
      "Body_import_bank_transactions_imports_bank_post": {
