            "type": "string",
            "title": "Txn Id"
          },
          "invoice_id": {
            "type": "string",
            "title": "Invoice Id"
          },
          "amount_applied": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount Applied"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
